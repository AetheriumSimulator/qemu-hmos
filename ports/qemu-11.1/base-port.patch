index 0000000000000000000000000000000000000000..53a2c160e5d3177b9cc32c5e1eb06951b7920c77
--- /dev/null
+++ b/qemu_hmos_exports.c
@@ -0,0 +1,164 @@
+/*
+ * HarmonyOS shared-core entry points for QEMU system emulation.
+ *
+ * QEMU is executed in a dedicated NativeChildProcess. Fatal QEMU exits are
+ * therefore process-local and must not be intercepted inside the core.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include CONFIG_DEVICES
+#include "qemu/main-loop.h"
+#include "system/qemu-hmos.h"
+#include "system/replay.h"
+#include "system/system.h"
+
+#define QEMU_HMOS_CORE_ABI 2
+
+#ifdef CONFIG_OPENGL
+#define QEMU_HMOS_FEATURE_OPENGL "1"
+#else
+#define QEMU_HMOS_FEATURE_OPENGL "0"
+#endif
+
+#if defined(CONFIG_OPENGL) && defined(CONFIG_VIRGL_RENDERER) && \
+    defined(CONFIG_VIRTIO_GPU) && defined(CONFIG_VIRTIO_PCI)
+#define QEMU_HMOS_FEATURE_VIRGL_GL "1"
+#else
+#define QEMU_HMOS_FEATURE_VIRGL_GL "0"
+#endif
+
+#ifdef CONFIG_FW_CFG_DMA
+#define QEMU_HMOS_FEATURE_RAMFB "1"
+#else
+#define QEMU_HMOS_FEATURE_RAMFB "0"
+#endif
+
+#if defined(CONFIG_VIRTIO_GPU) && defined(CONFIG_VIRTIO_PCI)
+#define QEMU_HMOS_FEATURE_VIRTIO_GPU_2D "1"
+#else
