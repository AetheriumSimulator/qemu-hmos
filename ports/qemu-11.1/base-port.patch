+#if defined(__OHOS__)
+#include <sys/prctl.h>
+
+/* HarmonyOS JITFORT must be opened around executable permission changes. */
+#ifndef PRCTL_SET_JITFORT
+#define PRCTL_SET_JITFORT 0x6a6974
+#endif
+#endif
+
 int socket_set_cork(int fd, int v)
 {
 #if defined(SOL_TCP) && defined(TCP_CORK)
@@ -82,7 +91,29 @@ static int qemu_mprotect__osdep(void *addr, size_t size, int prot)
     }
     return 0;
 #else
-    if (mprotect(addr, size, prot)) {
+#if defined(__OHOS__)
+    const bool executable = (prot & PROT_EXEC) != 0;
+
+    if (executable && prctl(PRCTL_SET_JITFORT, 0, 0) != 0) {
+        error_report("%s: could not open HarmonyOS JITFORT: %s",
+                     __func__, strerror(errno));
+        return -1;
+    }
+#endif
+
+    int ret = mprotect(addr, size, prot);
+    int saved_errno = errno;
+
+#if defined(__OHOS__)
+    if (executable && prctl(PRCTL_SET_JITFORT, 0, 1) != 0 && ret == 0) {
