+# Device configuration for an AArch64 HarmonyOS-hosted virtual machine.
+# SPDX-License-Identifier: GPL-2.0-or-later
+#
+# Keep this as a positive list on top of QEMU's ARM virt board. The build uses
+# --without-default-devices so unrelated ARM development boards and legacy
+# devices are not pulled into the application shared library.
+
+CONFIG_ARM_VIRT=y
+
+# Firmware and installation display, plus the post-driver display device.
+# RAMFB is selected by ARM_VIRT through FW_CFG_DMA.
+CONFIG_VIRTIO_GPU=y
+
+# PCI transport and the storage/network devices exposed by the application.
+CONFIG_VIRTIO_PCI=y
+CONFIG_VIRTIO_BLK=y
+CONFIG_VIRTIO_SCSI=y
+CONFIG_VIRTIO_NET=y
+CONFIG_VIRTIO_SERIAL=y
+CONFIG_VIRTIO_RNG=y
+CONFIG_VIRTIO_BALLOON=y
+CONFIG_VIRTIO_INPUT=y
+CONFIG_VIRTIO_SND=y
+CONFIG_NVME_PCI=y
+CONFIG_SPDM_SOCKET=y
+CONFIG_E1000_PCI=y
+CONFIG_E1000E_PCI_EXPRESS=y
+
+# Windows installation media and host audio devices.
+CONFIG_AHCI_ICH9=y
+CONFIG_HDA=y
+
+# Remote input, removable media, and authorized host USB passthrough.
+CONFIG_USB_XHCI_PCI=y
+CONFIG_USB_XHCI_NEC=y
+CONFIG_USB_HID=y
+CONFIG_USB_STORAGE_CLASSIC=y
+CONFIG_USB_STORAGE_BOT=y
+CONFIG_USB_AUDIO=y
+CONFIG_USB_NETWORK=y
+
+# ARM virt exposes the TPM through the sysbus TIS model.
+CONFIG_TPM_EMULATOR=y
+CONFIG_TPM_TIS_SYSBUS=y
