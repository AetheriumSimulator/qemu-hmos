diff --git a/audio/ohos_ohaudio.c b/audio/ohos_ohaudio.c
new file mode 100644
index 0000000000000000000000000000000000000000..73ceb04f23b780b6427a57f3c9d51ad1d23b223b
--- /dev/null
+++ b/audio/ohos_ohaudio.c
@@ -0,0 +1,564 @@
+/*
+ * HarmonyOS OHAudio backend
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/error-report.h"
+#include "qemu/module.h"
+#include "qemu/thread.h"
+#include "qom/object.h"
+
+#include <ohaudio/native_audiocapturer.h>
+#include <ohaudio/native_audiorenderer.h>
+#include <ohaudio/native_audiostreambuilder.h>
+
+#include "qemu/audio.h"
+#include "audio_int.h"
+
+#define TYPE_AUDIO_OHOS_OHAUDIO "audio-ohos-ohaudio"
+OBJECT_DECLARE_SIMPLE_TYPE(AudioOhosOHAudio, AUDIO_OHOS_OHAUDIO)
+
+#define OHOS_OHAUDIO_DEFAULT_BUFFER_USEC 60000
+#define OHOS_OHAUDIO_MIN_BUFFER_FRAMES 256
+
+struct AudioOhosOHAudio {
+    AudioMixengBackend parent_obj;
+};
+
+typedef struct OhosOHAudioRingBuffer {
+    uint8_t *data;
+    size_t size;
+    size_t read_pos;
+    size_t write_pos;
+    size_t used;
+} OhosOHAudioRingBuffer;
+
+typedef struct OhosOHAudioVoiceOut {
+    HWVoiceOut hw;
+    QemuMutex lock;
+    OhosOHAudioRingBuffer ring;
+    OH_AudioRenderer *renderer;
+    bool started;
+} OhosOHAudioVoiceOut;
+
+typedef struct OhosOHAudioVoiceIn {
+    HWVoiceIn hw;
+    QemuMutex lock;
+    OhosOHAudioRingBuffer ring;
+    OH_AudioCapturer *capturer;
+    bool started;
+} OhosOHAudioVoiceIn;
+
+static void ohos_ohaudio_ring_init(OhosOHAudioRingBuffer *ring, size_t size)
+{
+    ring->data = g_malloc0(size);
+    ring->size = size;
+    ring->read_pos = 0;
+    ring->write_pos = 0;
+    ring->used = 0;
+}
+
+static void ohos_ohaudio_ring_reset(OhosOHAudioRingBuffer *ring)
+{
+    ring->read_pos = 0;
+    ring->write_pos = 0;
+    ring->used = 0;
+}
+
+static void ohos_ohaudio_ring_fini(OhosOHAudioRingBuffer *ring)
+{
+    g_clear_pointer(&ring->data, g_free);
+    ring->size = 0;
+    ohos_ohaudio_ring_reset(ring);
+}
+
+static size_t ohos_ohaudio_ring_write(OhosOHAudioRingBuffer *ring,
+                                      const uint8_t *src, size_t size)
+{
+    size_t first;
+
+    if (!ring->data || !ring->size || !size) {
+        return 0;
+    }
+
+    if (size >= ring->size) {
+        src += size - ring->size;
+        size = ring->size;
+        ohos_ohaudio_ring_reset(ring);
+    }
+
+    if (size > ring->size - ring->used) {
+        size_t drop = size - (ring->size - ring->used);
+
+        ring->read_pos = (ring->read_pos + drop) % ring->size;
+        ring->used -= drop;
+    }
+
+    first = MIN(size, ring->size - ring->write_pos);
+    memcpy(ring->data + ring->write_pos, src, first);
+    if (size > first) {
+        memcpy(ring->data, src + first, size - first);
+    }
+    ring->write_pos = (ring->write_pos + size) % ring->size;
+    ring->used += size;
+    return size;
+}
+
+static size_t ohos_ohaudio_ring_write_available(OhosOHAudioRingBuffer *ring,
+                                                const uint8_t *src,
+                                                size_t size)
+{
+    size_t first;
+
+    if (!ring->data || !ring->size || !size) {
+        return 0;
+    }
+
+    size = MIN(size, ring->size - ring->used);
+    first = MIN(size, ring->size - ring->write_pos);
+    memcpy(ring->data + ring->write_pos, src, first);
+    if (size > first) {
+        memcpy(ring->data, src + first, size - first);
+    }
+    ring->write_pos = (ring->write_pos + size) % ring->size;
+    ring->used += size;
+    return size;
+}
+
+static size_t ohos_ohaudio_ring_read(OhosOHAudioRingBuffer *ring,
+                                     uint8_t *dst, size_t size)
+{
+    size_t first;
+
+    size = MIN(size, ring->used);
+    if (!size) {
+        return 0;
+    }
+
+    first = MIN(size, ring->size - ring->read_pos);
+    memcpy(dst, ring->data + ring->read_pos, first);
+    if (size > first) {
+        memcpy(dst + first, ring->data, size - first);
+    }
+    ring->read_pos = (ring->read_pos + size) % ring->size;
+    ring->used -= size;
+    return size;
+}
+
+static void ohos_ohaudio_fill_silence(const struct audio_pcm_info *info,
+                                      void *buffer, size_t size)
+{
+    int value = info->af == AUDIO_FORMAT_U8 ? 0x80 : 0;
+
+    memset(buffer, value, size);
+}
+
+static bool ohos_ohaudio_result_ok(OH_AudioStream_Result result,
+                                   const char *operation)
+{
+    if (result == AUDIOSTREAM_SUCCESS) {
+        return true;
+    }
+
+    error_report("ohos-ohaudio: %s failed (result=%d)", operation,
+                 (int)result);
+    return false;
+}
+
+static bool ohos_ohaudio_sample_format(AudioFormat format,
+                                       OH_AudioStream_SampleFormat *result)
+{
+    switch (format) {
+    case AUDIO_FORMAT_U8:
+        *result = AUDIOSTREAM_SAMPLE_U8;
+        return true;
+    case AUDIO_FORMAT_S16:
+        *result = AUDIOSTREAM_SAMPLE_S16LE;
+        return true;
+    case AUDIO_FORMAT_S32:
+        *result = AUDIOSTREAM_SAMPLE_S32LE;
+        return true;
+    case AUDIO_FORMAT_F32:
+        *result = AUDIOSTREAM_SAMPLE_F32LE;
+        return true;
+    case AUDIO_FORMAT_S8:
+    case AUDIO_FORMAT_U16:
+    case AUDIO_FORMAT_U32:
+    case AUDIO_FORMAT__MAX:
+        return false;
+    }
+
+    return false;
+}
+
+static bool ohos_ohaudio_configure_builder(OH_AudioStreamBuilder *builder,
+                                           const audsettings *settings,
+                                           OH_AudioStream_SampleFormat format)
+{
+    return ohos_ohaudio_result_ok(
+               OH_AudioStreamBuilder_SetSamplingRate(builder,
+                                                      settings->freq),
+               "set sampling rate") &&
+           ohos_ohaudio_result_ok(
+               OH_AudioStreamBuilder_SetChannelCount(builder,
+                                                      settings->nchannels),
+               "set channel count") &&
+           ohos_ohaudio_result_ok(
+               OH_AudioStreamBuilder_SetSampleFormat(builder, format),
+               "set sample format") &&
+           ohos_ohaudio_result_ok(
+               OH_AudioStreamBuilder_SetEncodingType(
+                   builder, AUDIOSTREAM_ENCODING_TYPE_RAW),
+               "set encoding type") &&
+           ohos_ohaudio_result_ok(
+               OH_AudioStreamBuilder_SetLatencyMode(
+                   builder, AUDIOSTREAM_LATENCY_MODE_NORMAL),
+               "set latency mode");
+}
+
+static OH_AudioData_Callback_Result ohos_ohaudio_renderer_write(
+    OH_AudioRenderer *renderer, void *user_data, void *audio_data,
+    int32_t audio_data_size)
+{
+    OhosOHAudioVoiceOut *voice = user_data;
+
+    (void)renderer;
+    if (!voice || !audio_data || audio_data_size <= 0) {
+        return AUDIO_DATA_CALLBACK_RESULT_INVALID;
+    }
+
+    ohos_ohaudio_fill_silence(&voice->hw.info, audio_data,
+                              (size_t)audio_data_size);
+    qemu_mutex_lock(&voice->lock);
+    ohos_ohaudio_ring_read(&voice->ring, audio_data,
+                           (size_t)audio_data_size);
+    qemu_mutex_unlock(&voice->lock);
+    return AUDIO_DATA_CALLBACK_RESULT_VALID;
+}
+
+static void ohos_ohaudio_capturer_read(OH_AudioCapturer *capturer,
+                                       void *user_data, void *audio_data,
+                                       int32_t audio_data_size)
+{
+    OhosOHAudioVoiceIn *voice = user_data;
+
+    (void)capturer;
+    if (!voice || !audio_data || audio_data_size <= 0) {
+        return;
+    }
+
+    qemu_mutex_lock(&voice->lock);
+    ohos_ohaudio_ring_write(&voice->ring, audio_data,
+                            (size_t)audio_data_size);
+    qemu_mutex_unlock(&voice->lock);
+}
+
+static int ohos_ohaudio_create_renderer(OhosOHAudioVoiceOut *voice,
+                                        const audsettings *settings,
+                                        OH_AudioStream_SampleFormat format)
+{
+    OH_AudioStreamBuilder *builder = NULL;
+    OH_AudioRenderer *renderer = NULL;
+    OH_AudioStream_Result result;
+    bool configured;
+
+    result = OH_AudioStreamBuilder_Create(&builder,
+                                          AUDIOSTREAM_TYPE_RENDERER);
+    if (!ohos_ohaudio_result_ok(result, "create renderer builder") ||
+        !builder) {
+        return -1;
+    }
+
+    configured = ohos_ohaudio_configure_builder(builder, settings, format) &&
+        ohos_ohaudio_result_ok(
+            OH_AudioStreamBuilder_SetRendererInfo(
+                builder, AUDIOSTREAM_USAGE_MUSIC),
+            "set renderer usage") &&
+        ohos_ohaudio_result_ok(
+            OH_AudioStreamBuilder_SetRendererWriteDataCallback(
+                builder, ohos_ohaudio_renderer_write, voice),
+            "set renderer callback");
+    if (configured) {
+        result = OH_AudioStreamBuilder_GenerateRenderer(builder, &renderer);
+        configured = ohos_ohaudio_result_ok(result, "generate renderer") &&
+            renderer;
+    }
+
+    result = OH_AudioStreamBuilder_Destroy(builder);
+    if (!ohos_ohaudio_result_ok(result, "destroy renderer builder")) {
+        configured = false;
+    }
+    if (!configured) {
+        if (renderer) {
+            OH_AudioRenderer_Release(renderer);
+        }
+        return -1;
+    }
+
+    voice->renderer = renderer;
+    return 0;
+}
+
+static int ohos_ohaudio_create_capturer(OhosOHAudioVoiceIn *voice,
+                                        const audsettings *settings,
+                                        OH_AudioStream_SampleFormat format)
+{
+    OH_AudioStreamBuilder *builder = NULL;
+    OH_AudioCapturer *capturer = NULL;
+    OH_AudioStream_Result result;
+    bool configured;
+
+    result = OH_AudioStreamBuilder_Create(&builder,
+                                          AUDIOSTREAM_TYPE_CAPTURER);
+    if (!ohos_ohaudio_result_ok(result, "create capturer builder") ||
+        !builder) {
+        return -1;
+    }
+
+    configured = ohos_ohaudio_configure_builder(builder, settings, format) &&
+        ohos_ohaudio_result_ok(
+            OH_AudioStreamBuilder_SetCapturerInfo(
+                builder, AUDIOSTREAM_SOURCE_TYPE_MIC),
+            "set capturer source") &&
+        ohos_ohaudio_result_ok(
+            OH_AudioStreamBuilder_SetCapturerReadDataCallback(
+                builder, ohos_ohaudio_capturer_read, voice),
+            "set capturer callback");
+    if (configured) {
+        result = OH_AudioStreamBuilder_GenerateCapturer(builder, &capturer);
+        configured = ohos_ohaudio_result_ok(result, "generate capturer") &&
+            capturer;
+    }
+
+    result = OH_AudioStreamBuilder_Destroy(builder);
+    if (!ohos_ohaudio_result_ok(result, "destroy capturer builder")) {
+        configured = false;
+    }
+    if (!configured) {
+        if (capturer) {
+            OH_AudioCapturer_Release(capturer);
+        }
+        return -1;
+    }
+
+    voice->capturer = capturer;
+    return 0;
+}
+
+static int ohos_ohaudio_init_out(HWVoiceOut *hw, audsettings *settings)
+{
+    OhosOHAudioVoiceOut *voice = container_of(hw, OhosOHAudioVoiceOut, hw);
+    AudiodevPerDirectionOptions *options = audio_get_pdo_out(hw->s->dev);
+    OH_AudioStream_SampleFormat format;
+    size_t ring_size;
+
+    if (settings->big_endian ||
+        !ohos_ohaudio_sample_format(settings->fmt, &format)) {
+        error_report("ohos-ohaudio: unsupported playback format %s-endian %s",
+                     settings->big_endian ? "big" : "little",
+                     AudioFormat_str(settings->fmt));
+        return -1;
+    }
+
+    audio_pcm_init_info(&hw->info, settings);
+    hw->samples = MAX(OHOS_OHAUDIO_MIN_BUFFER_FRAMES,
+                      audio_buffer_frames(options, settings,
+                                          OHOS_OHAUDIO_DEFAULT_BUFFER_USEC));
+    ring_size = hw->samples * hw->info.bytes_per_frame;
+    qemu_mutex_init(&voice->lock);
+    ohos_ohaudio_ring_init(&voice->ring, ring_size);
+
+    if (ohos_ohaudio_create_renderer(voice, settings, format) < 0) {
+        ohos_ohaudio_ring_fini(&voice->ring);
+        qemu_mutex_destroy(&voice->lock);
+        return -1;
+    }
+    return 0;
+}
+
+static void ohos_ohaudio_fini_out(HWVoiceOut *hw)
+{
+    OhosOHAudioVoiceOut *voice = container_of(hw, OhosOHAudioVoiceOut, hw);
+
+    if (voice->renderer) {
+        if (voice->started) {
+            OH_AudioRenderer_Stop(voice->renderer);
+            voice->started = false;
+        }
+        OH_AudioRenderer_Release(voice->renderer);
+        voice->renderer = NULL;
+    }
+    ohos_ohaudio_ring_fini(&voice->ring);
+    qemu_mutex_destroy(&voice->lock);
+}
+
+static size_t ohos_ohaudio_write(HWVoiceOut *hw, void *buffer, size_t size)
+{
+    OhosOHAudioVoiceOut *voice = container_of(hw, OhosOHAudioVoiceOut, hw);
+    size_t written;
+
+    qemu_mutex_lock(&voice->lock);
+    written = ohos_ohaudio_ring_write_available(&voice->ring, buffer, size);
+    qemu_mutex_unlock(&voice->lock);
+    return written;
+}
+
+static size_t ohos_ohaudio_buffer_get_free(HWVoiceOut *hw)
+{
+    OhosOHAudioVoiceOut *voice = container_of(hw, OhosOHAudioVoiceOut, hw);
+    size_t generic_free = audio_generic_buffer_get_free(hw);
+    size_t generic_in_use = hw->samples * hw->info.bytes_per_frame -
+                            generic_free;
+    size_t available;
+
+    qemu_mutex_lock(&voice->lock);
+    available = voice->ring.size - voice->ring.used;
+    qemu_mutex_unlock(&voice->lock);
+
+    return available > generic_in_use ? available - generic_in_use : 0;
+}
+
+static void ohos_ohaudio_enable_out(HWVoiceOut *hw, bool enable)
+{
+    OhosOHAudioVoiceOut *voice = container_of(hw, OhosOHAudioVoiceOut, hw);
+    OH_AudioStream_Result result;
+
+    if (!voice->renderer || enable == voice->started) {
+        return;
+    }
+
+    if (enable) {
+        result = OH_AudioRenderer_Start(voice->renderer);
+        if (ohos_ohaudio_result_ok(result, "start renderer")) {
+            voice->started = true;
+        }
+    } else {
+        result = OH_AudioRenderer_Pause(voice->renderer);
+        if (ohos_ohaudio_result_ok(result, "pause renderer")) {
+            voice->started = false;
+        }
+        qemu_mutex_lock(&voice->lock);
+        ohos_ohaudio_ring_reset(&voice->ring);
+        qemu_mutex_unlock(&voice->lock);
+    }
+}
+
+static int ohos_ohaudio_init_in(HWVoiceIn *hw, audsettings *settings)
+{
+    OhosOHAudioVoiceIn *voice = container_of(hw, OhosOHAudioVoiceIn, hw);
+    AudiodevPerDirectionOptions *options = audio_get_pdo_in(hw->s->dev);
+    OH_AudioStream_SampleFormat format;
+    size_t ring_size;
+
+    if (settings->big_endian ||
+        !ohos_ohaudio_sample_format(settings->fmt, &format)) {
+        error_report("ohos-ohaudio: unsupported capture format %s-endian %s",
+                     settings->big_endian ? "big" : "little",
+                     AudioFormat_str(settings->fmt));
+        return -1;
+    }
+
+    audio_pcm_init_info(&hw->info, settings);
+    hw->samples = MAX(OHOS_OHAUDIO_MIN_BUFFER_FRAMES,
+                      audio_buffer_frames(options, settings,
+                                          OHOS_OHAUDIO_DEFAULT_BUFFER_USEC));
+    ring_size = hw->samples * hw->info.bytes_per_frame;
+    qemu_mutex_init(&voice->lock);
+    ohos_ohaudio_ring_init(&voice->ring, ring_size);
+
+    if (ohos_ohaudio_create_capturer(voice, settings, format) < 0) {
+        ohos_ohaudio_ring_fini(&voice->ring);
+        qemu_mutex_destroy(&voice->lock);
+        return -1;
+    }
+    return 0;
+}
+
+static void ohos_ohaudio_fini_in(HWVoiceIn *hw)
+{
+    OhosOHAudioVoiceIn *voice = container_of(hw, OhosOHAudioVoiceIn, hw);
+
+    if (voice->capturer) {
+        if (voice->started) {
+            OH_AudioCapturer_Stop(voice->capturer);
+            voice->started = false;
+        }
+        OH_AudioCapturer_Release(voice->capturer);
+        voice->capturer = NULL;
+    }
+    ohos_ohaudio_ring_fini(&voice->ring);
+    qemu_mutex_destroy(&voice->lock);
+}
+
+static size_t ohos_ohaudio_read(HWVoiceIn *hw, void *buffer, size_t size)
+{
+    OhosOHAudioVoiceIn *voice = container_of(hw, OhosOHAudioVoiceIn, hw);
+    size_t captured;
+
+    qemu_mutex_lock(&voice->lock);
+    captured = ohos_ohaudio_ring_read(&voice->ring, buffer, size);
+    qemu_mutex_unlock(&voice->lock);
+    return captured;
+}
+
+static void ohos_ohaudio_enable_in(HWVoiceIn *hw, bool enable)
+{
+    OhosOHAudioVoiceIn *voice = container_of(hw, OhosOHAudioVoiceIn, hw);
+    OH_AudioStream_Result result;
+
+    if (!voice->capturer || enable == voice->started) {
+        return;
+    }
+
+    if (enable) {
+        result = OH_AudioCapturer_Start(voice->capturer);
+        if (ohos_ohaudio_result_ok(result, "start capturer")) {
+            voice->started = true;
+        }
+    } else {
+        result = OH_AudioCapturer_Pause(voice->capturer);
+        if (ohos_ohaudio_result_ok(result, "pause capturer")) {
+            voice->started = false;
+        }
+        qemu_mutex_lock(&voice->lock);
+        ohos_ohaudio_ring_reset(&voice->ring);
+        qemu_mutex_unlock(&voice->lock);
+    }
+}
+
+static void ohos_ohaudio_class_init(ObjectClass *klass, const void *data)
+{
+    AudioMixengBackendClass *backend = AUDIO_MIXENG_BACKEND_CLASS(klass);
+
+    backend->max_voices_out = 1;
+    backend->max_voices_in = 1;
+    backend->voice_size_out = sizeof(OhosOHAudioVoiceOut);
+    backend->voice_size_in = sizeof(OhosOHAudioVoiceIn);
+
+    backend->init_out = ohos_ohaudio_init_out;
+    backend->fini_out = ohos_ohaudio_fini_out;
+    backend->write = ohos_ohaudio_write;
+    backend->buffer_get_free = ohos_ohaudio_buffer_get_free;
+    backend->run_buffer_out = audio_generic_run_buffer_out;
+    backend->enable_out = ohos_ohaudio_enable_out;
+
+    backend->init_in = ohos_ohaudio_init_in;
+    backend->fini_in = ohos_ohaudio_fini_in;
+    backend->read = ohos_ohaudio_read;
+    backend->run_buffer_in = audio_generic_run_buffer_in;
+    backend->enable_in = ohos_ohaudio_enable_in;
+}
+
+static const TypeInfo ohos_ohaudio_types[] = {
+    {
+        .name = TYPE_AUDIO_OHOS_OHAUDIO,
+        .parent = TYPE_AUDIO_MIXENG_BACKEND,
+        .instance_size = sizeof(AudioOhosOHAudio),
+        .class_init = ohos_ohaudio_class_init,
+    },
+};
+
+DEFINE_TYPES(ohos_ohaudio_types)
+module_obj(TYPE_AUDIO_OHOS_OHAUDIO);
