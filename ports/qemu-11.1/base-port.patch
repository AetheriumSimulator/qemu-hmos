+{
+    return QEMU_VERSION;
+}
+
+QEMU_HMOS_EXPORT
+int qemu_hmos_probe(int argc, char **argv)
+{
+    qemu_init(argc, argv);
+    qemu_cleanup(0);
+
+    /* Match system/main.c before returning to the disposable child. */
+    bql_unlock();
+    replay_mutex_unlock();
+    return 0;
+}
+
+QEMU_HMOS_EXPORT
+int qemu_hmos_run(int argc, char **argv)
+{
+    int status;
+
+    qemu_init(argc, argv);
+    status = qemu_main_loop();
+    qemu_cleanup(status);
+
+    /* Match system/main.c before returning to the NativeChildProcess entry. */
+    bql_unlock();
+    replay_mutex_unlock();
+    return status;
+}
